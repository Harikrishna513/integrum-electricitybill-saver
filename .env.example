# Copy this file to .env and fill in real values.
# Never commit .env to git.

# --- Gemini (field parsing, summaries, agent chat, OCR fallback) ---
# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Bill OCR pipeline ---
# mistral_ocr = Mistral OCR 3 reads the bill, Gemini parses fields (recommended)
# gemini      = Gemini vision only (legacy)
# mistral     = Pixtral vision only (legacy)
BILL_EXTRACTION_PROVIDER=mistral_ocr
BILL_EXTRACTION_FALLBACK=true

# Mistral Document AI OCR — https://console.mistral.ai/
# Model: mistral-ocr-latest (OCR 3). Aliases: mistral-ocr-3.0, mistral-ocr-2512
# Eval/free tier: rate-limited (~1 req/s); OCR billed ~$2–4 per 1,000 pages on Scale plan.
MISTRAL_API_KEY=your_mistral_key_here
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Legacy Pixtral vision (only if BILL_EXTRACTION_PROVIDER=mistral)
MISTRAL_MODEL=pixtral-large-latest

# SQLite for local learning; switch to PostgreSQL later
DATABASE_URL=sqlite:///./data/bescom_bill_saver.db

# Milestone 2 — local bill uploads (never commit real bills)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760

# development | production
APP_ENV=development
LOG_LEVEL=INFO

# Milestone 20 — official docs for RAG (VNM/GNM/KSEC)
DOCS_DIR=./data/Docs

# Milestone 23 — CORS for Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PUBLIC_URL=http://127.0.0.1:8000
