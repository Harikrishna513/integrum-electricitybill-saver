# Copy this file to .env and fill in real values.
# Never commit .env to git.

# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Swap model without changing application code
GEMINI_MODEL=gemini-2.5-flash

# SQLite for local learning; switch to PostgreSQL later
DATABASE_URL=sqlite:///./data/bescom_bill_saver.db

# Milestone 2 — local bill uploads (never commit real bills)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760

# development | production
APP_ENV=development
LOG_LEVEL=INFO

# Milestone 20 — official docs for RAG (VNM/GNM/KSEC)
DOCS_DIR=./data/Docs

# Milestone 23 — CORS for Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PUBLIC_URL=http://127.0.0.1:8000
